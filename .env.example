# ==============================================================================
# NFTMintport Environment Variables Configuration
# Copy this file to .env and populate the required fields.
# NEVER commit .env to version control or expose real private keys.
# ==============================================================================

# Network & RPC Settings
# Local default: http://127.0.0.1:8545 (Hardhat / Anvil)
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Deployer / Signer Private Key
# For local testing, use standard test mnemonic or hardhat default test private key:
# (0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80)
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Seaport Protocol Addresses (Default: Seaport v1.6 canonical Create2 addresses)
SEAPORT_ADDRESS=0x0000000000000068F116a894984e2DB1123eB395
CONDUIT_CONTROLLER_ADDRESS=0x00000000F9490004C103FB2A09CE222342427011

# Safety Flags
# Test token must NOT be deployed to mainnets unless explicitly overridden for staging
ALLOW_TEST_TOKEN_ON_MAINNET=false

# Block Explorer API Keys (for contract verification only)
ETHERSCAN_API_KEY=
